# Copy to .env and keep private.

# ============================================================================
# Remote Blender computer — used by the WINDOWS PowerShell tunnel scripts.
# These values are NOT needed by the SSH client inside Docker because Docker
# does not run the tunnel.
# ============================================================================
BLENDER_SSH_HOST=192.168.1.100
BLENDER_SSH_PORT=22
BLENDER_SSH_USER=REPLACE_WITH_REMOTE_SSH_USERNAME

# Blender MCP port:
# - Windows Computer 1 listens locally on this port through the SSH tunnel.
# - Remote Computer 2 Blender addon listens on localhost on the same port.
# - Docker reaches Computer 1 using host.docker.internal:<port>.
BLENDER_PORT=9876
BLENDER_MCP_SAFE_MODE=1

# SSH authentication files live beside the Windows scripts:
#
# scripts/blender_mcp
#   Private key generated/kept on Computer 1. Gitignored.
#
# scripts/blender_mcp.pub
#   Matching public key. Copy its contents to Computer 2 authorized_keys.
#
# scripts/blender_known_hosts
#   Verified host key entry for Computer 2. Gitignored.
#
# No SSH_DIR variable is required.

# ============================================================================
# Bambu Lab P2S — consumed by bambu-printer-mcp inside Docker.
# ============================================================================
PRINTER_HOST=192.168.1.123
BAMBU_MODEL=p2s
BAMBU_SERIAL=REPLACE_WITH_P2S_SERIAL
BAMBU_TOKEN=REPLACE_WITH_LAN_ACCESS_CODE
NOZZLE_DIAMETER=0.4

# Optional repo-local APIs if needed later
# GEMINI_API_KEY=
