# Copy to .env and keep private.

# ============================================================================
# Blender MCP — Computer 2 direct LAN connection
# ============================================================================
# Set this to Computer 2's LAN IPv4 address.
BLENDER_HOST=192.168.1.50
BLENDER_PORT=9876
BLENDER_MCP_SAFE_MODE=1

# Computer 2 requirements:
# - Blender is running.
# - Blender MCP addon/server is running.
# - Blender MCP listener accepts LAN connections on port 9876.
# - Windows Firewall on Computer 2 allows TCP 9876 from Computer 1's LAN IP.
#
# No SSH variables or key files are required.

# ============================================================================
# Bambu Lab P2S
# ============================================================================
PRINTER_HOST=192.168.1.123
BAMBU_MODEL=p2s
BAMBU_SERIAL=REPLACE_WITH_P2S_SERIAL
BAMBU_TOKEN=REPLACE_WITH_LAN_ACCESS_CODE
NOZZLE_DIAMETER=0.4

# Optional repo-local APIs if needed later
# GEMINI_API_KEY=
